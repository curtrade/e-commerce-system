{
  "name": "e-commerce-system",
  "version": "0.0.1",
  "description": "Naive microservice e-commerce: orders saga, payments, inventory, notifications",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && nest build orders && nest build payments && nest build inventory && nest build notifications",
    "build:orders": "nest build orders",
    "build:payments": "nest build payments",
    "build:inventory": "nest build inventory",
    "build:notifications": "nest build notifications",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:orders": "nest start orders --watch",
    "start:payments": "nest start payments --watch",
    "start:inventory": "nest start inventory --watch",
    "start:notifications": "nest start notifications --watch",
    "start:prod:orders": "node dist/apps/orders/apps/orders/src/main.js",
    "start:prod:payments": "node dist/apps/payments/apps/payments/src/main.js",
    "start:prod:inventory": "node dist/apps/inventory/apps/inventory/src/main.js",
    "start:prod:notifications": "node dist/apps/notifications/apps/notifications/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:cov": "jest --coverage",
    "prisma:orders:generate": "prisma generate --schema apps/orders/prisma/schema.prisma",
    "prisma:orders:migrate:dev": "prisma migrate dev --schema apps/orders/prisma/schema.prisma",
    "prisma:orders:migrate:deploy": "prisma migrate deploy --schema apps/orders/prisma/schema.prisma",
    "prisma:orders:migrate:status": "prisma migrate status --schema apps/orders/prisma/schema.prisma",
    "prisma:orders:studio": "prisma studio --schema apps/orders/prisma/schema.prisma",
    "prisma:payments:generate": "prisma generate --schema apps/payments/prisma/schema.prisma",
    "prisma:payments:migrate:dev": "prisma migrate dev --schema apps/payments/prisma/schema.prisma",
    "prisma:payments:migrate:deploy": "prisma migrate deploy --schema apps/payments/prisma/schema.prisma",
    "prisma:payments:migrate:status": "prisma migrate status --schema apps/payments/prisma/schema.prisma",
    "prisma:payments:studio": "prisma studio --schema apps/payments/prisma/schema.prisma",
    "prisma:inventory:generate": "prisma generate --schema apps/inventory/prisma/schema.prisma",
    "prisma:inventory:migrate:dev": "prisma migrate dev --schema apps/inventory/prisma/schema.prisma",
    "prisma:inventory:migrate:deploy": "prisma migrate deploy --schema apps/inventory/prisma/schema.prisma",
    "prisma:inventory:migrate:status": "prisma migrate status --schema apps/inventory/prisma/schema.prisma",
    "prisma:inventory:studio": "prisma studio --schema apps/inventory/prisma/schema.prisma",
    "prisma:notifications:generate": "prisma generate --schema apps/notifications/prisma/schema.prisma",
    "prisma:notifications:migrate:dev": "prisma migrate dev --schema apps/notifications/prisma/schema.prisma",
    "prisma:notifications:migrate:deploy": "prisma migrate deploy --schema apps/notifications/prisma/schema.prisma",
    "prisma:notifications:migrate:status": "prisma migrate status --schema apps/notifications/prisma/schema.prisma",
    "prisma:notifications:studio": "prisma studio --schema apps/notifications/prisma/schema.prisma"
  },
  "dependencies": {
    "@itgorillaz/configify": "^4.1.2",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.4.1",
    "@prisma/client": "^6.1.0",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.6.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.13.1",
    "prisma": "^6.1.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.0.0",
    "@testcontainers/redis": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "nock": "^14.0.15",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
