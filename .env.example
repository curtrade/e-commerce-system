# Secrets — sensitive values, stored in Docker Swarm Secrets for production.
# On the server: /opt/ecommerce/.env.secrets (chmod 600)
DATABASE_URL_ORDERS=postgres://user:password@postgres-host:5432/orders
DATABASE_URL_PAYMENTS=postgres://user:password@postgres-host:5432/payments
DATABASE_URL_INVENTORY=postgres://user:password@postgres-host:5432/inventory
DATABASE_URL_NOTIFICATIONS=postgres://user:password@postgres-host:5432/notifications
REDIS_URL_ORDERS=redis://:password@redis-host:6379/0
REDIS_URL_PAYMENTS=redis://:password@redis-host:6379/2
REDIS_URL_INVENTORY=redis://:password@redis-host:6379/1
REDIS_URL_NOTIFICATIONS=redis://:password@redis-host:6379/3
KAFKA_BROKERS=kafka-host:9092

# Config — non-sensitive values, passed as env vars in docker-stack.yml.
# On the server: /opt/ecommerce/.env
IMAGE_PREFIX=ghcr.io/<owner>/ecommerce
IMAGE_TAG=latest
OTEL_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=info
RESERVATION_TTL_SEC=900
SAGA_TIMEOUT_SEC=60
SENDER_EMAIL=ops@example.com
