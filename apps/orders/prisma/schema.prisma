// Prisma schema for the `orders` service.
// Reflects the current `orders` database state (init-db.sql + the two
// node-pg-migrate migrations that swapped trace_id for trace_context).
// Naming: PascalCase singular models, camelCase fields, snake_case in DB via @map / @@map.
// See .claude/skills/prisma-nest/SKILL.md for the full conventions.

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-orders"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id             String   @id @db.Uuid
  customerId     String   @map("customer_id")
  email          String
  // Embedded order lines. Kept as JSONB for now; normalize to OrderItem
  // when the read path needs it.
  items          Json     @db.JsonB
  total          Decimal  @db.Decimal(12, 2)
  status         String
  reservationId  String?  @map("reservation_id") @db.Uuid
  paymentId      String?  @map("payment_id") @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, createdAt], map: "orders_status_created_idx")
  @@map("orders")
}

model OrdersOutbox {
  id           String    @id @db.Uuid
  aggregateId  String    @map("aggregate_id") @db.Uuid
  topic        String
  eventType    String    @map("event_type")
  payload      Json      @db.JsonB
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  publishedAt  DateTime? @map("published_at") @db.Timestamptz()
  // W3C traceparent captured at outbox-write time so the publisher can
  // resume the original trace on dispatch (added in migration 1779373518241).
  traceContext String?   @map("trace_context")

  // NOTE: the production DB also carries a partial index
  //   CREATE INDEX orders_outbox_unpublished_idx
  //     ON orders_outbox (created_at) WHERE published_at IS NULL;
  // Prisma schema syntax cannot express partial indexes, so it lives in the
  // baseline migration SQL only. Future changes to it must go through raw
  // SQL inside a migration step — do not redeclare it as a regular @@index
  // here (Prisma migrate would attempt to drop the partial one).

  @@map("orders_outbox")
}
